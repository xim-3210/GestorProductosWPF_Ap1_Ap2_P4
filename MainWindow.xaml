<Window x:Class="GestorProductosWPF_Ap1_Ap2_P4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestorProductosWPF_Ap1_Ap2_P4"
        mc:Ignorable="d"
        Title="Gestor de Productos" Height="540" Width="920" MinHeight="480" MinWidth="780"
        Background="#EEF5FC" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Paleta en azules claros -->
        <SolidColorBrush x:Key="FondoVentanaBrush" Color="#EEF5FC"/>
        <SolidColorBrush x:Key="FondoTarjetaBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BordeSuaveBrush" Color="#C7DDF2"/>
        <SolidColorBrush x:Key="AzulPrimarioBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AzulPrimarioHoverBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AzulSecundarioBrush" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="AzulSecundarioHoverBrush" Color="#BFDBFE"/>
        <SolidColorBrush x:Key="TextoOscuroBrush" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="TextoSecundarioBrush" Color="#527194"/>

        <!-- Estilo de pestañas -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#DCEBFA"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#C7DDF2"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EBF4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de botón principal -->
        <Style x:Key="BtnAzulPrincipal" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AzulPrimarioBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource AzulPrimarioHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de botón secundario -->
        <Style x:Key="BtnAzulSecundario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AzulSecundarioBrush}"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource AzulSecundarioHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de tarjeta -->
        <Style x:Key="TarjetaAzul" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FondoTarjetaBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordeSuaveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Estilo de subtítulos -->
        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <TabControl Background="Transparent" BorderThickness="0">

            <!-- ==================== PESTAÑA 1: INVENTARIO ==================== -->
            <TabItem x:Name="Inventario" Header="Inventario">
                <Border Style="{StaticResource TarjetaAzul}" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Catálogo de productos" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextoOscuroBrush}"/>
                            <TextBlock Text="Consulta, agrega o elimina registros del inventario actual." FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </StackPanel>

                        <DataGrid x:Name="dataGridProductos"
                                  Grid.Row="1"
                                  d:ItemsSource="{d:SampleData ItemCount=5}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2EEF9"
                                  RowBackground="#FFFFFF"
                                  AlternatingRowBackground="#F4F9FF"
                                  BorderBrush="#C7DDF2"
                                  BorderThickness="1"
                                  FontSize="13"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button x:Name="btnEliminar"
                                    Content="Eliminar"
                                    Style="{StaticResource BtnAzulSecundario}"
                                    Height="38" Width="135" Margin="0,0,10,0"
                                    Click="btnEliminar_Click"/>
                            <Button x:Name="btnAgregar"
                                    Content="Agregar"
                                    Style="{StaticResource BtnAzulPrincipal}"
                                    Height="38" Width="150"
                                    Click="btnAgregar_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
            
            <!-- ==================== PESTAÑA 2: BÚSQUEDA ==================== -->
            <TabItem x:Name="Busqueda" Header="Busqueda">
                <Border Style="{StaticResource TarjetaAzul}" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Búsqueda de productos" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextoOscuroBrush}"/>
                            <TextBlock Text="Elige el criterio, ingresa el valor a buscar y revisa las iteraciones realizadas." FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </StackPanel>

                        <!-- Controles de búsqueda -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Tipo de búsqueda" Style="{StaticResource EtiquetaCampo}"/>
                                <ComboBox x:Name="comboTipoBusqueda" Height="34" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Término o valor a buscar" Style="{StaticResource EtiquetaCampo}"/>
                                <TextBox x:Name="txtBusqueda" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#BFD7EA"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <Button x:Name="btnBuscar"
                                        Content="Buscar"
                                        Style="{StaticResource BtnAzulPrincipal}"
                                        Height="34" Width="140"
                                        Click="btnBuscar_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Resultados y progreso -->
                        <Border Grid.Row="2" Background="#F4F9FF" BorderBrush="#D6E8FA" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Resultado de la búsqueda" Style="{StaticResource EtiquetaCampo}"/>

                                <TextBlock x:Name="txtResultadoBusquda"
                                           Grid.Row="1"
                                           TextWrapping="Wrap"
                                           Text="Sin búsqueda realizada aún."
                                           FontSize="14"
                                           Foreground="{StaticResource TextoOscuroBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock Text="Iteraciones de la búsqueda" Style="{StaticResource EtiquetaCampo}"/>
                                    <Grid Height="26">
                                        <ProgressBar x:Name="progresoIteraciones"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="100"
                                                     Background="#DCEBFA"
                                                     Foreground="#93C5FD"
                                                     BorderBrush="#BDD7F1"
                                                     BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ==================== PESTAÑA 3: ORDENAMIENTO ==================== -->
            <TabItem x:Name="Ordenamiento" Header="Ordenamiento">
                <Border Style="{StaticResource TarjetaAzul}" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Text="Ordenamiento y visualización" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextoOscuroBrush}"/>
                            <TextBlock Text="Selecciona el criterio de orden y revisa la lista ordenada y el gráfico." FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </StackPanel>

                        <!-- Panel izquierdo: configuración y gráfico -->
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Tipo de ordenamiento" Style="{StaticResource EtiquetaCampo}"/>
                                <ComboBox x:Name="comboTipoOrden" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                <Button x:Name="btnOrdenar"
                                        Content="Ordenar"
                                        Style="{StaticResource BtnAzulPrincipal}"
                                        Height="36"
                                        Click="btnOrdenar_Click"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="#F4F9FF" BorderBrush="#C7DDF2" BorderThickness="1" CornerRadius="8" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Gráfico de barras" Style="{StaticResource EtiquetaCampo}"/>
                                    <Canvas x:Name="CanvasGrafico" Grid.Row="1" Background="#F4F9FF">
                                        <Rectangle x:Name="Rectangulo"
                                                   Height="110" Width="38"
                                                   Canvas.Left="24" Canvas.Top="24"
                                                   Fill="#93C5FD" Stroke="#93C5FD" StrokeThickness="1"
                                                   RadiusX="4" RadiusY="4"/>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Panel derecho: lista ordenada -->
                        <Border Grid.Row="1" Grid.Column="2" Background="#F4F9FF" BorderBrush="#D6E8FA" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Productos ordenados" Style="{StaticResource EtiquetaCampo}"/>

                                <ListView x:Name="ListViewOrdenados"
                                          Grid.Row="1"
                                          d:ItemsSource="{d:SampleData ItemCount=5}"
                                          Background="#FFFFFF"
                                          BorderBrush="#C7DDF2"
                                          BorderThickness="1"
                                          FontSize="13"
                                          Foreground="{StaticResource TextoOscuroBrush}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Producto" DisplayMemberBinding="{Binding Nombre}" Width="260"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>